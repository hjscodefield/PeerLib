# Server Port
PORT=5000

# Database Configuration (MySQL)
# Set USE_MYSQL=true when connecting to a live MySQL instance
USE_MYSQL=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peerlib_db

# When USE_MYSQL=false or MySQL is unreachable, PeerLib seamlessly uses 
# the embedded local database store at backend/database/peerlib_store.json
